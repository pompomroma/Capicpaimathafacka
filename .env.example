# Required NVIDIA NIM API keys — store as Replit Secrets, never commit
NIM_KEY_REASONING=nvapi-your-reasoning-and-voice-key
NIM_KEY_VISION=nvapi-your-vision-key
NIM_KEY_CODEGEN=nvapi-your-codegen-key

# JWT secret for auth cookie
JWT_SECRET=replace-with-a-long-random-string

# Optional overrides
PORT=3000
LLM_MODEL=meta/llama-3.3-70b-instruct
VISION_MODEL=meta/llama-3.2-90b-vision-instruct
CODEGEN_MODEL=qwen/qwen3-coder-480b-a35b-instruct
TTS_MODEL=nvidia/fastpitch-hifigan-en-us
STT_MODEL=nvidia/parakeet-ctc-1.1b
# Pick any Riva US voice. Calm/Happy variants sound more natural than Female-1.
# Alternatives: English-US.Female-1, English-US.Male-1, English-US.Female-Happy
TTS_VOICE=English-US.Female-Calm
